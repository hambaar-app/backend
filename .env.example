# Copy to `.env.development` / `.env.production`.
# Docker Compose reads `./.docker/.env` instead (POSTGRES_*, REDIS_*, PORT, ...).
# Every key below is validated at boot by `src/common/config/env.validation.ts`.

# --- Required: infrastructure ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hambaar-db
REDIS_URL=redis://:redis@localhost:6379
OTP_REDIS_URL=redis://:redis@localhost:6379/1
SESSION_REDIS_URL=redis://:redis@localhost:6379/2

# --- Required: secrets (min 16 chars where noted) ---
SESSION_SECRET=change-me-min-16-chars
COOKIE_SECRET=change-me
JWT_ACCESS_SECRET_KEY=change-me-min-16-chars
JWT_TEMP_SECRET_KEY=change-me-min-16-chars
JWT_PROGRESS_SECRET_KEY=change-me-min-16-chars

# --- Required: storage / external APIs ---
AWS_ACCESS_KEY=change-me
AWS_SECRET_KEY=change-me
AWS_BUCKET_NAME=hambaar
AWS_ENDPOINT=https://s3.example.com
MAP_API_KEY=change-me
MAP_API_URL=https://api.neshan.org/v1
SMS_API_KEY=change-me

# --- Optional: runtime (defaults shown) ---
# MAX_UPLOAD_SIZE_MB=10
# JWT_ACCESS_EXPIRES_IN=20d
# JWT_TEMP_EXPIRES_IN=20m
# JWT_PROGRESS_EXPIRES_IN=1d
# PORT=3000
# API_PREFIX=api
# CORS_ORIGINS=http://localhost:8080
# LOG_LEVEL=log
# TIMEOUT_MS=30000
# RESPONSE_WRAPPER_ENABLED=true
# MEMORY_HEAP_THRESHOLD_MB=150
# COOKIE_MAX_AGE=1296000000
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
# THROTTLE_TTL=60
# THROTTLE_LIMIT=100
# PRISMA_TX_TIMEOUT_MS=
# AWS_REGION=default

# --- Optional: OTP flow ---
# OTP_EXPIRATION_TIME=120000
# MAX_SEND_ATTEMPTS=5
# MAX_CHECK_ATTEMPTS=10
# SEND_WINDOW=1800000
# BASE_BLOCK_TIME=1200000

# --- Optional: pricing (defaults mirror the legacy service) ---
# PRICING_BASE_PRICE=50000
# PRICING_FUEL_RATE=200
# PRICING_WEIGHT_BASE_RATE=10000
# NOTE: both keys below are validated as @IsInt, so fractional values fail
# boot (known quirk — see REFACTOR.md). Only DRIVER_SHARE is read (0.7);
# PLATFORM_COMMISSION is currently unused by the engine.
# PRICING_PLATFORM_COMMISSION=0.3
# PRICING_DRIVER_SHARE=0.7
# PRICING_FRAGILE_MULTIPLIER=1.25
# PRICING_PERISHABLE_MULTIPLIER=1.35
# PRICING_BOTH_FRAGILE_PERISHABLE=1.5
# PRICING_MAJOR_CITY_ORIGIN=0.9
# PRICING_MAJOR_CITY_DESTINATION=1.3
# PRICING_BOTH_MAJOR_CITIES=1.0
# PRICING_SMALL_CITY_FACTOR=1.2
# PRICING_DEVIATION_RATE=15000
# PRICING_TIME_DEVIATION_RATE=5000
# PRICING_TIER_1_RATE=1000
# PRICING_TIER_2_RATE=950
# PRICING_TIER_3_RATE=850
# PRICING_TIER_4_RATE=750
# PRICING_TIER_5_RATE=600
# PRICING_MAJOR_CITIES=تهران,اصفهان,مشهد
# CORRIDOR_WIDTH=10

# --- Optional: boot behavior ---
# SEED_ON_BOOT=false
